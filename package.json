{
  "name": "orca-straude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Straude daily spend, token usage, profile and rankings in Orca.",
  "license": "MIT",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "orca plugin test . --json",
    "validate": "orca plugin validate . --json",
    "check": "orca plugin check . --json",
    "install:local": "node scripts/install-local.mjs",
    "ci": "npm run lint && npm test && npm run check",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "lefthook": "2.2.2"
  }
}
